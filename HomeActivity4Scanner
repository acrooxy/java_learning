import java.util.Scanner;

public class HomeActivity4Scanner {
    public static void main(String[] args) {

        System.out.println("Welcome to BMI Calculator");

        System.out.println("Give me your height in inches or cm");
        System.out.println("1. inch \n2. cm");

        Scanner UserChoicLengthUnit = new Scanner(System.in);
        int outcomecm = 0;
        int outcomeCm = 0;
        if (UserChoicLengthUnit.hasNextInt()) {
            int choice = UserChoicLengthUnit.nextInt();
            //Scanner inchLength  = new Scanner(System.in);

            if (choice == 1) {
                System.out.println("Inch");
                Scanner inchLength = new Scanner(System.in);
                double inchLen = inchLength.nextDouble();
                double cmOutcome = inchLen  * 2.54;
                int cmOutcomeInt = (int) Math.round(cmOutcome); // switch double to int and Round up number
                System.out.println("cmOutcome: " + cmOutcomeInt);
                outcomecm = cmOutcomeInt;



            }
            else if (choice == 2) {
                System.out.println("Type height in cm:");
                Scanner heightInCm = new Scanner(System.in);


                outcomeCm = heightInCm.nextInt();
                System.out.println("CM : " + outcomeCm);

            }
            else {
                System.out.println("Invalid choice");
            }

        }

        int outcome = outcomecm + outcomeCm;
        System.out.println("Outcome : " + outcome);
        double heightM = outcome / 100.0;
        Scanner Weight = new Scanner(System.in);
        System.out.println("Weight in Kg:");
        double weightKg = Weight.nextDouble();

        double BMI = weightKg / (heightM * heightM);
        System.out.printf("BMI : %.2f%n", BMI);


        if (BMI < 18.5) {
            System.out.println("Underweight");
        }
        else if (BMI >= 18.5 && BMI < 25) {
            System.out.println("Healthy weight");
        }
        else if (BMI >= 25 && BMI < 30) {
            System.out.println("Overweight");
        }
        else if (BMI >= 30 && BMI < 35) {
            System.out.println("Obesity");
        }
    }
}
